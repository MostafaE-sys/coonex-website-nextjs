# Production Environment Variables
# Copy this file to .env.local for local overrides, or configure these in
# your hosting platform for production/staging. Never commit real values.

# REQUIRED before production deploy — the real production site URL, used for
# canonical links, Open Graph URLs, and the generated sitemap/robots. Falls
# back to http://localhost:3000 if unset, which must never reach production.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# REQUIRED before the Contact form can deliver leads to a human. A webhook
# URL that the /api/contact route POSTs each validated lead to as JSON
# ({ name, email, company, phone?, topic, message }). This could point to an
# email-sending service, a CRM's inbound-webhook endpoint, or an automation
# tool (e.g. Zapier/Make) — whichever provider Coonex chooses. Leave unset in
# any environment where lead delivery isn't yet configured; submissions will
# be rejected with a clear error rather than silently discarded.
CONTACT_DELIVERY_WEBHOOK_URL=
